{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run API dev",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\fastapi.exe",
      "args": ["dev", "main.py", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
